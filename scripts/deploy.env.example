# AIDriveWorkflow 远程部署配置
# 复制为 scripts/deploy.env 并填写（deploy.env 勿提交 git）

AIDRIVENOTE_DEPLOY_HOST=<你的服务器IP或域名>
AIDRIVENOTE_DEPLOY_USER=ubuntu
AIDRIVENOTE_DEPLOY_PATH=/home/ubuntu/AIDriveWorkflow
AIDRIVENOTE_FRONTEND_PORT=3320

# 生产环境（子路径部署，按需修改）— enable-sso.sh 会自动写入，亦可手动确认：
VITE_BASE_PATH=/workflow/
VITE_API_URL=/workflow/api/v1
NGINX_SUBPATH=1
APP_HEALTH_PATH=/workflow/health
CORS_ORIGINS=https://<你的域名>
